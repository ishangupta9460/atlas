# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit real credentials.

# --- Backend server ---
SERVER_PORT=8080

# --- Database (MySQL / Aiven) ---
# Example Aiven format: jdbc:mysql://<host>:<port>/<database>?ssl-mode=REQUIRED
DB_URL=jdbc:mysql://localhost:3306/atlas
DB_USERNAME=
DB_PASSWORD=

# --- Optional AI (supply credentials through the process environment only) ---
# Enable/disable the AI adapter.
ATLAS_AI_ENABLED=
# Provider credential; never store a real key in this file.
ATLAS_AI_API_KEY=
# Override the configured model.
ATLAS_AI_MODEL=
